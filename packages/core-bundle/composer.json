{
  "name": "autoflow/core-bundle",
  "description": "Transport-neutral Clean Architecture foundation for AutoFlow Symfony microservices, with HTTP, serialization and RoadRunner gRPC adapters.",
  "type": "symfony-bundle",
  "license": "proprietary",
  "version": "2.0.0",
  "require": {
    "php": "^8.4",
    "symfony/config": "7.4.*",
    "symfony/dependency-injection": "7.4.*",
    "symfony/framework-bundle": "7.4.*",
    "symfony/http-client": "7.4.*",
    "symfony/http-kernel": "7.4.*",
    "symfony/messenger": "7.4.*",
    "symfony/routing": "7.4.*",
    "symfony/yaml": "7.4.*",
    "roadrunner/grpc": "^3.8",
    "roadrunner/http": "^4.0",
    "nyholm/psr7": "^1.8",
    "symfony/psr-http-message-bridge": "7.4.*",
    "firebase/php-jwt": "^7.2.1"
  },
  "autoload": {
    "psr-4": {
      "AutoFlow\\CoreBundle\\": "src/"
    }
  },
  "config": {
    "sort-packages": true
  },
  "extra": {
    "symfony": {
      "allow-contrib": false
    }
  },
  "suggest": {}
}
