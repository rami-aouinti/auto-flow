{
  "name": "rami-aouinti/auto-flow",
  "description": "Enterprise mobility platform built with Symfony microservices.",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "^8.4",
    "ext-ctype": "*",
    "ext-iconv": "*",
    "ext-intl": "*",
    "ext-pdo": "*",
    "ext-pdo_pgsql": "*",
    "ext-sockets": "*"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.85",
    "phpmd/phpmd": "^2.15",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^11.5",
    "squizlabs/php_codesniffer": "^3.13",
    "rector/rector": "^2.0"
  },
  "config": {"sort-packages": true, "optimize-autoloader": true, "platform": {"php": "8.4.0"}},
  "scripts": {
    "cs": "php-cs-fixer fix --dry-run --diff",
    "cs:fix": "php-cs-fixer fix",
    "phpcs": "phpcs --standard=phpcs.xml",
    "phpcs:fix": "phpcbf --standard=phpcs.xml",
    "phpstan": "phpstan analyse --configuration=phpstan.neon --memory-limit=1G",
    "phpmd": "phpmd apps,packages,tests text phpmd.xml",
    "rector:check": "rector process --dry-run",
    "rector:fix": "rector process",
    "test": "phpunit --configuration=phpunit.xml",
    "coverage": "XDEBUG_MODE=coverage phpunit --configuration=phpunit.xml --coverage-text",
    "security:audit": "composer audit",
    "quality": ["@cs", "@phpcs", "@phpstan", "@phpmd", "@rector:check", "@test", "@security:audit"]
  }
}
