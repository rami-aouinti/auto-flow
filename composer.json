{
    "name": "rami-aouinti/auto-flow",
    "description": "Enterprise mobility platform built with Symfony microservices.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "ext-intl": "*",
        "ext-pdo": "*",
        "ext-pdo_pgsql": "*",
        "ext-sockets": "*"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.85",
        "phpmd/phpmd": "^2.15",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5",
        "squizlabs/php_codesniffer": "^3.13",
        "rector/rector": "^2.0",
        "symfony/config": "7.4.*",
        "symfony/dependency-injection": "7.4.*",
        "symfony/framework-bundle": "7.4.*",
        "symfony/http-client": "7.4.*",
        "symfony/http-kernel": "7.4.*",
        "symfony/messenger": "7.4.*",
        "symfony/routing": "7.4.*",
        "symfony/yaml": "7.4.*",
        "nyholm/psr7": "^1.8",
        "roadrunner/grpc": "^3.8",
        "roadrunner/http": "^4.0",
        "symfony/psr-http-message-bridge": "7.4.*",
        "firebase/php-jwt": "^7.2.1"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "platform": {
            "php": "8.4.0"
        }
    },
    "scripts": {
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix",
        "phpcs": "phpcs --standard=phpcs.xml",
        "phpcs:fix": "phpcbf --standard=phpcs.xml",
        "phpstan": "phpstan analyse --configuration=phpstan.neon --memory-limit=1G",
        "phpmd": "phpmd apps,packages,tests text phpmd.xml",
        "rector:check": "rector process --dry-run",
        "rector:fix": "rector process",
        "test": "phpunit --configuration=phpunit.xml",
        "coverage": "XDEBUG_MODE=coverage phpunit --configuration=phpunit.xml --coverage-text",
        "security:audit": "composer audit",
        "quality": [
            "@cs",
            "@phpcs",
            "@phpstan",
            "@phpmd",
            "@rector:check",
            "@test",
            "@security:audit"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "AutoFlow\\Tests\\": "tests/",
            "AutoFlow\\CoreBundle\\": "packages/core-bundle/src/",
            "App\\Security\\": "apps/offer-service/src/Security/",
            "App\\Domain\\": "apps/offer-service/src/Domain/",
            "App\\": "apps/offer-service/src/"
        }
    }
}
