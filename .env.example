APP_ENV=dev
APP_DEBUG=1

# Local browser-based API documentation (Swagger UI).
# Override with prod/0 in production deployments.
OFFER_APP_ENV=dev
OFFER_APP_DEBUG=1
CATALOG_APP_ENV=dev
CATALOG_APP_DEBUG=1
PRICING_APP_ENV=dev
PRICING_APP_DEBUG=1
ORDER_APP_ENV=prod
ORDER_APP_DEBUG=0

POSTGRES_DB=autoflow
POSTGRES_USER=autoflow
POSTGRES_PASSWORD=autoflow
ADMINER_PORT=8083

RABBITMQ_USER=autoflow
RABBITMQ_PASSWORD=autoflow

ELASTICSEARCH_URL=http://elasticsearch:9200
MERCURE_URL=http://mercure/.well-known/mercure
MERCURE_PUBLIC_URL=http://localhost:3001/.well-known/mercure
# Development-only keys. Generate strong random values before sharing or deploying.
MERCURE_PUBLISHER_JWT_KEY=change-this-publisher-key-for-local-development
MERCURE_SUBSCRIBER_JWT_KEY=change-this-subscriber-key-for-local-development

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-this-grafana-password

# Local Keycloak development realm (never reuse these credentials outside local development).
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_ISSUER=http://localhost:8080/realms/autoflow
KEYCLOAK_JWKS_URI=http://keycloak:8080/realms/autoflow/protocol/openid-connect/certs
PRICING_CLIENT_ID=autoflow-offer-to-pricing
PRICING_CLIENT_SECRET=autoflow-local-offer-to-pricing-secret
# Separate database role for Offer Service (local development only).
OFFER_DATABASE_URL=postgresql://autoflow_offer:local-only-offer-password@postgres:5432/autoflow
# Separate database role for Vehicle Catalog Service (local development only).
CATALOG_DATABASE_URL=postgresql://autoflow_catalog:local-only-catalog-password@postgres:5432/autoflow

# Separate database role for Order Management (local development only).
ORDER_DATABASE_URL=postgresql://autoflow_order:local-only-order-password@postgres:5432/autoflow

# Notification Service (local development only; use secrets in production).
NOTIFICATION_DATABASE_URL=postgresql://autoflow:autoflow@postgres:5432/autoflow
KEYCLOAK_NOTIFICATION_CLIENT_ID=autoflow-notification
KEYCLOAK_NOTIFICATION_CLIENT_SECRET=autoflow-local-notification-secret
MAILER_DSN=smtp://mailpit:1025
MAIL_FROM_ADDRESS=offers@autoflow.local
MAIL_FROM_NAME=AutoFlow Mobility
