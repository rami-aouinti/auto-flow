APP_ENV=dev
APP_DEBUG=1

# Local browser-based API documentation (Swagger UI).
# Override with prod/0 in production deployments.
OFFER_APP_ENV=dev
OFFER_APP_DEBUG=1
CATALOG_APP_ENV=dev
CATALOG_APP_DEBUG=1
PRICING_APP_ENV=dev
PRICING_APP_DEBUG=1
ORDER_APP_ENV=prod
ORDER_APP_DEBUG=0

POSTGRES_DB=autoflow
POSTGRES_USER=autoflow
POSTGRES_PASSWORD=autoflow
ADMINER_PORT=8083

RABBITMQ_USER=autoflow
RABBITMQ_PASSWORD=autoflow

ELASTICSEARCH_URL=http://elasticsearch:9200
MERCURE_URL=http://mercure/.well-known/mercure
MERCURE_PUBLIC_URL=http://localhost:3001/.well-known/mercure
# Development-only keys. Generate strong random values before sharing or deploying.
MERCURE_PUBLISHER_JWT_KEY=change-this-publisher-key-for-local-development
MERCURE_SUBSCRIBER_JWT_KEY=change-this-subscriber-key-for-local-development
MERCURE_COOKIE_SECURE=false # Set true behind HTTPS in production

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-this-grafana-password

# Local Keycloak development realm (never reuse these credentials outside local development).
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_ISSUER=http://localhost:8080/realms/autoflow
KEYCLOAK_JWKS_URI=http://keycloak:8080/realms/autoflow/protocol/openid-connect/certs
PRICING_CLIENT_ID=autoflow-offer-to-pricing
PRICING_CLIENT_SECRET=autoflow-local-offer-to-pricing-secret
# Separate database role for Offer Service (local development only).
OFFER_DATABASE_URL=postgresql://autoflow_offer:local-only-offer-password@postgres:5432/autoflow
# Separate database role for Vehicle Catalog Service (local development only).
CATALOG_DATABASE_URL=postgresql://autoflow_catalog:local-only-catalog-password@postgres:5432/autoflow

# Separate database role for Order Management (local development only).
ORDER_DATABASE_URL=postgresql://autoflow_order:local-only-order-password@postgres:5432/autoflow
ORDER_PUBLISHER_DATABASE_URL=postgresql://autoflow_order_publisher:local-only-order-publisher-password@postgres:5432/autoflow
ORDER_OFFER_SERVICE_URL=http://offer-service:8080
ORDER_PRICING_SERVICE_URL=http://pricing-service:8080
ORDER_CATALOG_SERVICE_URL=http://vehicle-catalog-service:8080
ORDER_CUSTOMER_SERVICE_URL=http://customer-service:8080

# Contract Service (local development only).
CONTRACT_DATABASE_URL=postgresql://autoflow_contract:local-only-contract-password@postgres:5432/autoflow
RESERVATION_DATABASE_URL=postgresql://autoflow_reservation:local-only-reservation-password@postgres:5432/autoflow
RESERVATION_PUBLISHER_DATABASE_URL=postgresql://autoflow_reservation_publisher:local-only-reservation-publisher-password@postgres:5432/autoflow
RESERVATION_WORKER_DATABASE_URL=postgresql://autoflow_reservation_worker:local-only-reservation-worker-password@postgres:5432/autoflow
INVENTORY_DATABASE_URL=postgresql://autoflow_inventory:local-only-inventory-password@postgres:5432/autoflow
RESERVATION_EXPIRY_INTERVAL_SECONDS=5
RESERVATION_EXPIRY_BATCH_SIZE=100
CONTRACT_ORDER_SERVICE_URL=http://order-service:8080
CONTRACT_PUBLISHER_DATABASE_URL=postgresql://autoflow_contract_publisher:local-only-contract-publisher-password@postgres:5432/autoflow
CONTRACT_DOCUMENT_STORAGE_PATH=/var/lib/autoflow/contracts
# DocuSign demo defaults. Supply integration/user/account IDs and mount the RSA key securely.
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_USER_ID=
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_OAUTH_HOST=account-d.docusign.com
DOCUSIGN_API_BASE_URL=https://demo.docusign.net/restapi
DOCUSIGN_PRIVATE_KEY_PATH=/run/secrets/docusign-rsa-private.pem
DOCUSIGN_WEBHOOK_HMAC_KEY=

ORDER_PAYMENT_SHARED_SECRET=local-only-order-payment-shared-secret

# Customer Service (local development only).
DOCUMENT_DATABASE_URL=postgresql://autoflow_document:local-only-document-password@postgres:5432/autoflow
CUSTOMER_DATABASE_URL=postgresql://autoflow_customer:local-only-customer-password@postgres:5432/autoflow

# Payment Service (Stripe test mode; never commit live secrets).
VITE_STRIPE_PUBLISHABLE_KEY=
PAYMENT_APP_ENV=prod
PAYMENT_APP_DEBUG=0
PAYMENT_DATABASE_URL=postgresql://autoflow_payment:local-only-payment-password@postgres:5432/autoflow
BILLING_DATABASE_URL=postgresql://autoflow_billing:local-only-billing-password@postgres:5432/autoflow
DOCUMENT_SERVICE_URL=http://document-service:8080
BILLING_TAX_RATE_BPS=1900
# Supply the real legal entity data before issuing production invoices.
BILLING_ISSUER_LEGAL_NAME=
BILLING_ISSUER_TAX_NUMBER=
BILLING_ISSUER_VAT_ID=
# JSON object: {"line1":"...","postalCode":"...","city":"...","countryCode":"DE"}
BILLING_ISSUER_ADDRESS_JSON=
ORDER_PAYMENT_CONTEXT_URL=http://order-service:8080
PAYMENT_PUBLISHER_DATABASE_URL=postgresql://autoflow_payment_publisher:local-only-payment-publisher-password@postgres:5432/autoflow
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Durable order lifecycle orchestration (local Temporal development server).
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=autoflow-order-workflows

# Notification Service (local development only; use secrets in production).
NOTIFICATION_DATABASE_URL=postgresql://autoflow:autoflow@postgres:5432/autoflow
KEYCLOAK_NOTIFICATION_CLIENT_ID=autoflow-notification
KEYCLOAK_NOTIFICATION_CLIENT_SECRET=autoflow-local-notification-secret
MAILER_DSN=smtp://mailpit:1025
MAIL_FROM_ADDRESS=offers@autoflow.local
MAIL_FROM_NAME=AutoFlow Mobility

# AI Service (local development; Ollama runs locally in Docker).
AI_APP_SECRET=change-this-ai-service-secret
OLLAMA_MODEL=qwen2.5:3b

# Mercure deployment settings. Use a shared parent domain when the hub is on a subdomain.
AUTOFLOW_MERCURE_TOPIC_BASE=https://autoflow.local/tenants
MERCURE_CORS_ORIGINS=http://localhost:3000 http://localhost:8000
MERCURE_COOKIE_DOMAIN=
MERCURE_COOKIE_SAMESITE=Lax

# Dedicated Document maintenance role; rotate and protect this credential outside local development.
DOCUMENT_MAINTENANCE_DATABASE_URL=postgresql://autoflow_document_maintenance:local-only-document-maintenance-password@postgres:5432/autoflow
DOCUMENT_RETENTION_INTERVAL_SECONDS=3600
DOCUMENT_RETENTION_BATCH_SIZE=25

# Local RustFS S3 credentials. Override with managed S3 credentials outside development.
DOCUMENT_S3_REGION=us-east-1
DOCUMENT_S3_ACCESS_KEY=AUTOFLOWDOCUMENT
DOCUMENT_S3_SECRET_KEY=local-only-document-object-secret
DOCUMENT_S3_SSE_C_KEY_BASE64=YXV0b2Zsb3ctZG9jdW1lbnQtc3RvcmFnZS1rZXktMDE=

# Analytics and Integration Services (local development only; replace with managed secrets).
INTEGRATION_WEBHOOK_SECRET_DEMO=change-this-demo-provider-webhook-secret
INTEGRATION_OUTBOUND_ALLOWED_HOSTS=
INTEGRATION_DELIVERY_SIGNING_SECRET=change-this-outbound-delivery-signing-secret
