[unix_http_server]
file=/run/supervisor/autoflow.sock
chmod=0700

[supervisord]
nodaemon=false
logfile=/var/log/supervisor/autoflow-supervisord.log
pidfile=/run/supervisor/autoflow-supervisord.pid
childlogdir=/var/log/supervisor

[rpcinterface:supervisor]
supervisor.rpcinterface_factory = supervisor.rpcinterface:make_main_rpcinterface

[supervisorctl]
serverurl=unix:///run/supervisor/autoflow.sock

[program:offer-outbox-publisher]
directory=/srv/autoflow/apps/offer-service
command=/usr/bin/php bin/outbox-publisher.php
user=autoflow
autostart=true
autorestart=unexpected
startsecs=3
startretries=10
stopsignal=TERM
stopwaitsecs=30
stopasgroup=true
killasgroup=true
redirect_stderr=true
stdout_logfile=/var/log/supervisor/offer-outbox.log
stdout_logfile_maxbytes=20MB
stdout_logfile_backups=5

[program:catalog-outbox-publisher]
directory=/srv/autoflow/apps/vehicle-catalog-service
command=/usr/bin/php bin/publish-outbox.php
user=autoflow
autostart=true
autorestart=unexpected
startsecs=3
startretries=10
stopsignal=TERM
stopwaitsecs=30
stopasgroup=true
killasgroup=true
redirect_stderr=true
stdout_logfile=/var/log/supervisor/catalog-outbox.log
stdout_logfile_maxbytes=20MB
stdout_logfile_backups=5
