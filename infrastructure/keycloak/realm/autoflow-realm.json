{
  "realm": "autoflow",
  "enabled": true,
  "displayName": "AutoFlow Local Development",
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "accessTokenLifespan": 300,
  "clients": [
    {
      "clientId": "autoflow-local-client",
      "name": "AutoFlow local developer client",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:3000/*",
        "http://localhost:8081/*",
        "http://localhost:8082/*",
        "http://localhost:8084/*"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "http://localhost:8081",
        "http://localhost:8082",
        "http://localhost:8084"
      ],
      "protocolMappers": [
        {
          "name": "offer-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "autoflow-offer",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "pricing-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "autoflow-pricing",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "offer-to-pricing-requester-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "autoflow-offer-to-pricing",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "tenant-id-claim",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "vehicle-catalog-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "autoflow-catalog",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ],
      "defaultClientScopes": [
        "basic",
        "web-origins",
        "acr",
        "profile",
        "email",
        "roles"
      ],
      "fullScopeAllowed": true
    },
    {
      "clientId": "autoflow-offer",
      "name": "Offer Service resource audience",
      "enabled": true,
      "bearerOnly": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    },
    {
      "clientId": "autoflow-pricing",
      "name": "Pricing Service resource audience",
      "enabled": true,
      "bearerOnly": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    },
    {
      "clientId": "autoflow-offer-to-pricing",
      "name": "Offer Service to Pricing Service workload identity",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "autoflow-local-offer-to-pricing-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocolMappers": [
        {
          "name": "pricing-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "autoflow-pricing",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "tenant-id-claim",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        }
      ],
      "attributes": {
        "standard.token.exchange.enabled": "true"
      },
      "defaultClientScopes": [
        "basic",
        "web-origins",
        "acr",
        "profile",
        "email",
        "roles"
      ],
      "fullScopeAllowed": true
    },
    {
      "clientId": "autoflow-catalog",
      "name": "Vehicle Catalog Service resource audience",
      "enabled": true,
      "bearerOnly": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    }
  ],
  "users": [
    {
      "username": "demo",
      "enabled": true,
      "email": "demo@autoflow.local",
      "emailVerified": true,
      "firstName": "AutoFlow",
      "lastName": "Developer",
      "credentials": [
        {
          "type": "password",
          "value": "demo",
          "temporary": false
        }
      ],
      "realmRoles": [
        "offers:read",
        "offers:quote",
        "pricing:quote",
        "catalog:read"
      ],
      "attributes": {
        "tenant_id": [
          "tenant-demo"
        ]
      }
    },
    {
      "username": "catalog-admin",
      "enabled": true,
      "email": "catalog-admin@autoflow.local",
      "emailVerified": true,
      "firstName": "Catalogue",
      "lastName": "Administrator",
      "credentials": [
        {
          "type": "password",
          "value": "catalog-admin",
          "temporary": false
        }
      ],
      "realmRoles": [
        "catalog:read",
        "catalog:manage"
      ]
    }
  ],
  "roles": {
    "realm": [
      {
        "name": "offers:read",
        "description": "Read offer resources"
      },
      {
        "name": "offers:quote",
        "description": "Create pricing quotes through the Offer Service"
      },
      {
        "name": "pricing:quote",
        "description": "Calculate and access pricing quotes"
      },
      {
        "name": "catalog:read",
        "description": "Read published vehicle catalogue data"
      },
      {
        "name": "catalog:manage",
        "description": "Manage and publish vehicle catalogue entries"
      }
    ]
  }
}
