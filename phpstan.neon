parameters:
    level: 8
    paths:
        - apps
        - packages
        - tests
    excludePaths:
        analyse:
            - apps/offer-service/*
            - apps/pricing-service/*
    tmpDir: var/phpstan

    ignoreErrors:
        # PHPMD's documented suppression annotation is not standard PHPDoc syntax.
        - identifier: phpDoc.parseError
          path: packages/core-bundle/src/Security/JwksKeyProvider.php
        - identifier: phpDoc.parseError
          path: packages/core-bundle/src/Security/JwtTokenVerifier.php
        - identifier: phpDoc.parseError
          path: tests/Unit/CoreBundle/Security/JwtTokenVerifierTest.php
        - identifier: phpDoc.parseError
          path: apps/vehicle-catalog-service/src/Presentation/Http/Controller/CatalogController.php
        - identifier: phpDoc.parseError
          path: apps/vehicle-catalog-service/src/Infrastructure/Persistence/Doctrine/DoctrineVehicleCatalogRepository.php
        - identifier: phpDoc.parseError
          path: apps/vehicle-catalog-service/src/Infrastructure/Persistence/Doctrine/Entity/VehicleVariantRecord.php
        - identifier: phpDoc.parseError
          path: apps/vehicle-catalog-service/src/Domain/Entity/VehicleVariant.php
        - identifier: phpDoc.parseError
          path: apps/vehicle-catalog-service/src/Presentation/Http/Dto/Request/VehicleSearchCriteria.php
