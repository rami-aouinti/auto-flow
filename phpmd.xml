<?xml version="1.0"?>
<ruleset name="AutoFlow">
    <description>PHPMD rules for complexity, design and code smells.</description>
    <exclude-pattern>*/Infrastructure/RoadRunner/*</exclude-pattern>
    <exclude-pattern>*/Transport/Grpc/Generated/*</exclude-pattern>
    <exclude-pattern>*/Transport/Grpc/PlatformHealthGrpcService.php</exclude-pattern>
    <exclude-pattern>*/Grpc/*</exclude-pattern>
    <exclude-pattern>*/bin/*worker.php</exclude-pattern>
    <rule ref="rulesets/cleancode.xml"/>
    <rule ref="rulesets/codesize.xml"/>
    <rule ref="rulesets/controversial.xml"/>
    <rule ref="rulesets/design.xml"/>
    <rule ref="rulesets/naming.xml"/>
    <rule ref="rulesets/unusedcode.xml"/>
</ruleset>
