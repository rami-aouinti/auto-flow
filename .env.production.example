# Copy to .env.production outside source control and replace every placeholder.
# Never commit the real production file, API credentials, HMAC key or RSA key.

APP_ENV=prod
APP_DEBUG=0
KEYCLOAK_ISSUER=https://identity.example.com/realms/autoflow
KEYCLOAK_JWKS_URI=https://identity.example.com/realms/autoflow/protocol/openid-connect/certs

# Legal issuer data: enter the registered legal entity's real details.
BILLING_TAX_RATE_BPS=1900
BILLING_ISSUER_LEGAL_NAME=REPLACE_WITH_REGISTERED_LEGAL_NAME
BILLING_ISSUER_TAX_NUMBER=REPLACE_WITH_TAX_NUMBER
BILLING_ISSUER_VAT_ID=REPLACE_WITH_VAT_ID
BILLING_ISSUER_ADDRESS_JSON='{"line1":"REPLACE_WITH_STREET_AND_NUMBER","postalCode":"REPLACE_WITH_POSTAL_CODE","city":"REPLACE_WITH_CITY","countryCode":"DE"}'

# DocuSign production account (not the demo/sandbox host).
DOCUSIGN_INTEGRATION_KEY=REPLACE_WITH_INTEGRATION_KEY
DOCUSIGN_USER_ID=REPLACE_WITH_IMPERSONATED_USER_GUID
DOCUSIGN_ACCOUNT_ID=REPLACE_WITH_PRODUCTION_ACCOUNT_ID
DOCUSIGN_OAUTH_HOST=account.docusign.com
DOCUSIGN_API_BASE_URL=https://www.docusign.net/restapi
DOCUSIGN_WEBHOOK_HMAC_KEY=REPLACE_WITH_CONNECT_HMAC_SECRET
DOCUSIGN_PRIVATE_KEY_HOST_PATH=/secure/secrets/docusign-rsa-private.pem

# Set real service URLs, database credentials, JWT issuer/JWKS, SMTP and observability
# endpoints through your deployment secret manager before deploying.
