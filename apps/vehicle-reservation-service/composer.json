{
  "name": "autoflow/vehicle-reservation-service",
  "description": "Vehicle stock reservation bounded context for AutoFlow.",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "^8.4",
    "ext-json": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "AutoFlow\\VehicleReservation\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "AutoFlow\\VehicleReservation\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit --configuration phpunit.xml.dist"
  },
  "config": {
    "sort-packages": true,
    "platform": {
      "php": "8.4.0"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
