{
  "name": "autoflow/pricing-service",
  "description": "AutoFlow pricing microservice with an isolated leasing calculation domain.",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "^8.4",
    "ext-json": "*",
    "ext-opentelemetry": "*",
    "google/protobuf": "^4.0",
    "nyholm/psr7": "^1.8",
    "open-telemetry/exporter-otlp": "^1.4",
    "open-telemetry/opentelemetry-auto-symfony": "^1.7",
    "open-telemetry/sdk": "^1.8",
    "php-http/guzzle7-adapter": "^1.0",
    "roadrunner/grpc": "^3.8",
    "roadrunner/http": "^4.0",
    "symfony/asset": "7.4.*",
    "symfony/framework-bundle": "7.4.*",
    "symfony/http-client": "7.4.*",
    "symfony/flex": "^2.7",
    "symfony/psr-http-message-bridge": "7.4.*",
    "symfony/string": "7.4.*",
    "symfony/yaml": "7.4.*",
    "autoflow/core-bundle": "^2.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5",
    "nelmio/api-doc-bundle": "^5.13.2",
    "symfony/twig-bundle": "7.4.*"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../../packages/core-bundle",
      "options": {
        "symlink": false
      }
    }
  ],
  "autoload": {
    "psr-4": {
      "App\\": "src/",
      "App\\Grpc\\Generated\\": "src/App/Grpc/Generated/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "php-http/discovery": true,
      "symfony/flex": true
    },
    "platform": {
      "php": "8.4.0"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "extra": {
    "symfony": {
      "require": "7.4.*"
    }
  }
}
