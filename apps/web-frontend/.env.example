VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=autoflow
VITE_KEYCLOAK_CLIENT_ID=autoflow-local-client
VITE_CATALOG_API_BASE=/catalog
VITE_OFFER_API_BASE=/offers
VITE_PRICING_API_BASE=/pricing
CATALOG_PROXY_TARGET=http://vehicle-catalog-service:8080
OFFER_PROXY_TARGET=http://offer-service:8080
PRICING_PROXY_TARGET=http://pricing-service:8080
VITE_ORDER_API_BASE=/orders
VITE_PAYMENT_API_BASE=/payments
# Stripe publishable key only; never put STRIPE_SECRET_KEY in a VITE variable.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
ORDER_PROXY_TARGET=http://order-service:8080
PAYMENT_PROXY_TARGET=http://payment-service:8080

# Platform service proxies (business APIs are routed through the API Gateway).
AUDIT_PROXY_TARGET=http://api-gateway
ANALYTICS_PROXY_TARGET=http://api-gateway
CONFIGURATION_PROXY_TARGET=http://api-gateway
DOCUMENT_PROXY_TARGET=http://api-gateway
INTEGRATION_PROXY_TARGET=http://api-gateway
SEARCH_PROXY_TARGET=http://api-gateway
WORKFLOW_PROXY_TARGET=http://workflow-service:8080

# Optional public browser URL for the Mercure hub. The authorized topic is returned by Customer Service.
VITE_MERCURE_HUB_URL=http://localhost:3001/.well-known/mercure
