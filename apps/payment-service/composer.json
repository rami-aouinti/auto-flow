{
  "name": "autoflow/payment-service",
  "description": "Payment bounded context for AutoFlow using Stripe PaymentIntents.",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "^8.4",
    "ext-json": "*",
    "ext-pdo": "*",
    "ext-pdo_pgsql": "*",
    "ext-opentelemetry": "*",
    "autoflow/core-bundle": "^2.0",
    "doctrine/dbal": "^4.3",
    "doctrine/doctrine-bundle": "^3.3",
    "open-telemetry/api": "^1.3",
    "open-telemetry/exporter-otlp": "^1.4",
    "open-telemetry/opentelemetry-auto-symfony": "^1.7",
    "open-telemetry/sdk": "^1.8",
    "symfony/flex": "^2.7",
    "symfony/framework-bundle": "7.4.*",
    "symfony/http-client": "7.4.*",
    "symfony/uid": "7.4.*",
    "symfony/yaml": "7.4.*"
  },
  "repositories": [{"type":"path","url":"../../packages/core-bundle","options":{"symlink":false}}],
  "autoload": {"psr-4":{"App\\":"src/"}},
  "config":{"sort-packages":true,"allow-plugins":{"php-http/discovery":true,"symfony/flex":true},"platform":{"php":"8.4.0"}},
  "minimum-stability":"stable",
  "prefer-stable":true,
  "extra":{"symfony":{"require":"7.4.*"}}
}