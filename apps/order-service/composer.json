{
  "name": "autoflow/order-service",
  "description": "Order Management bounded context for the AutoFlow mobility platform.",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "^8.4",
    "ext-json": "*",
    "ext-opentelemetry": "*",
    "autoflow/core-bundle": "^2.0",
    "doctrine/dbal": "^4.3",
    "doctrine/doctrine-bundle": "^2.18",
    "open-telemetry/api": "^1.3",
    "open-telemetry/exporter-otlp": "^1.4",
    "open-telemetry/opentelemetry-auto-symfony": "^1.7",
    "open-telemetry/sdk": "^1.8",
    "php-amqplib/php-amqplib": "^3.7",
    "roadrunner/http": "^4.0",
    "nyholm/psr7": "^1.8",
    "symfony/flex": "^2.7",
    "symfony/framework-bundle": "7.4.*",
    "symfony/http-client": "7.4.*",
    "symfony/psr-http-message-bridge": "7.4.*",
    "symfony/uid": "7.4.*",
    "symfony/yaml": "7.4.*"
  },
  "repositories": [{"type":"path","url":"../../packages/core-bundle","options":{"symlink":false}}],
  "autoload": {"psr-4":{"App\\":"src/"}},
  "autoload-dev": {"psr-4":{"App\\Tests\\":"tests/"}},
  "scripts":{"test":"phpunit"},
  "config":{"sort-packages":true,"allow-plugins":{"php-http/discovery":true,"symfony/flex":true},"platform":{"php":"8.4.0"}},
  "minimum-stability":"stable",
  "prefer-stable":true,
  "extra":{"symfony":{"require":"7.4.*"}}
}
