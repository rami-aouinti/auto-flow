{
  "name": "autoflow/notification-service",
  "description": "Asynchronous notification microservice for AutoFlow offer lifecycle events.",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "^8.4",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-pdo": "*",
    "ext-pdo_pgsql": "*",
    "ext-sockets": "*",
    "php-amqplib/php-amqplib": "^3.7",
    "symfony/mailer": "7.4.*",
    "symfony/http-client": "7.4.*",
    "symfony/mime": "7.4.*"
  },
  "autoload": {
    "psr-4": {
      "AutoFlow\\Notification\\": "src/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  },
  "config": {
    "sort-packages": true,
    "platform": { "php": "8.4.0" }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}