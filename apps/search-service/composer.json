{
  "name": "autoflow/search-service",
  "description": "AutoFlow vehicle search backed by Elasticsearch and RabbitMQ catalogue events.",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "^8.4",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-pdo": "*",
    "ext-pdo_pgsql": "*",
    "nyholm/psr7": "^1.8",
    "php-amqplib/php-amqplib": "^3.7",
    "roadrunner/http": "^4.0",
    "symfony/framework-bundle": "7.4.*",
    "symfony/http-client": "7.4.*",
    "symfony/yaml": "7.4.*",
    "autoflow/core-bundle": "^2.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  },
  "repositories": [
    {"type": "path", "url": "../../packages/core-bundle", "options": {"symlink": false}}
  ],
  "autoload": {"psr-4": {"App\\": "src/"}},
  "autoload-dev": {"psr-4": {"App\\Tests\\": "tests/"}},
  "scripts": {"test": "phpunit"},
  "config": {
    "sort-packages": true,
    "allow-plugins": {"symfony/flex": true},
    "platform": {"php": "8.4.0"}
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "extra": {"symfony": {"require": "7.4.*"}}
}
