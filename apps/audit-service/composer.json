{
  "name": "autoflow/audit-service",
  "description": "Tenant-isolated immutable audit trail and compliance API.",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "^8.4",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-pdo": "*",
    "ext-pdo_pgsql": "*",
    "symfony/framework-bundle": "7.4.*",
    "symfony/http-foundation": "7.4.*",
    "symfony/routing": "7.4.*",
    "symfony/yaml": "7.4.*",
    "autoflow/core-bundle": "^2.0",
    "php-amqplib/php-amqplib": "^3.7",
    "ext-openssl": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../../packages/core-bundle",
      "options": {
        "symlink": false
      }
    }
  ],
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "config": {
    "sort-packages": true,
    "platform": {
      "php": "8.4.0"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "extra": {
    "symfony": {
      "require": "7.4.*"
    }
  }
}
