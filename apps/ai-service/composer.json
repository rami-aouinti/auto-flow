{
  "name": "autoflow/ai-service",
  "description": "AI provider gateway for the AutoFlow mobility platform.",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "^8.4",
    "ext-json": "*",
    "autoflow/core-bundle": "^2.0",
    "symfony/framework-bundle": "7.4.*",
    "symfony/http-client": "7.4.*",
    "symfony/flex": "^2.7",
    "symfony/yaml": "7.4.*"
  },
  "repositories": [{"type": "path", "url": "../../packages/core-bundle", "options": {"symlink": false}}],
  "autoload": {"psr-4": {"App\\": "src/"}},
  "config": {"sort-packages": true, "allow-plugins": {"symfony/flex": true}, "platform": {"php": "8.4.0"}},
  "minimum-stability": "stable",
  "prefer-stable": true,
  "extra": {"symfony": {"require": "7.4.*"}}
}
